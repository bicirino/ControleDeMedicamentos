# Configurações gerais
DEBUG=False

# URL do banco Postgres (Supabase)
# Exemplo: postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
DATABASE_URL= 

# Alternativa para Supabase, se preferir nome separado
SUPABASE_DB_URL=

# API Groq para busca de medicamentos
# Obtenha sua chave gratuitamente em: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
# Modelo opcional (padrão: openai/gpt-oss-20b). Lista: https://console.groq.com/docs/models
# GROQ_MODEL=openai/gpt-oss-20b
